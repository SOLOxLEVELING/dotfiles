{
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 10,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": ["group/left-island"],
  "modules-center": ["group/center-island"],
  "modules-right": ["group/right-island"],

  "group/left-island": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces", "wlr/taskbar"]
  },
  "group/center-island": {
    "orientation": "horizontal",
    "modules": ["mpris", "clock"]
  },
  "group/right-island": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "cpu",
      "memory",
      "pulseaudio",
      "network",
      "battery",
      "custom/power"
    ]
  },

  /* -----------------------------------------------------
     MODULE CONFIGURATION
  ----------------------------------------------------- */
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "◉",
      "default": "○"
    },
    "persistent-workspaces": { "*": 5 }
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 22,
    "icon-theme": "Papirus",
    "on-click": "activate"
  },

  /* MEDIA PLAYER - Icon Only */
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵",
      "spotify": "",
      "firefox": ""
    },
    "status-icons": {
      "paused": "⏸"
    },
    "tooltip-format": "{player} ({status})\n{dynamic}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "on-click": "kitty --class float_btop --title btop -o initial_window_width=1000 -o initial_window_height=700 -e btop"
  },
  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "on-click": "kitty --class float_btop --title btop -o initial_window_width=1000 -o initial_window_height=700 -e btop"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol"
  },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout"
  }
}
