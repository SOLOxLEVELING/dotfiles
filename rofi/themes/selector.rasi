/**
 * Theme Selector - Glassmorphism Style
 * A distinct floating card design
 */

* {
    /* Catppuccin Mocha Colors */
    bg:              #1e1e2e;
    bg-alt:          #313244;
    fg:              #cdd6f4;
    accent:          #89b4fa;
    accent-alt:      #cba6f7;
    urgent:          #f38ba8;
    
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 13";
}

window {
    background-color: @bg;
    border:           3px solid;
    border-color:     @accent;
    border-radius:    16px;
    width:            500px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    padding:          24px;
    spacing:          16px;
}

/* Header message showing current theme */
message {
    background-color: @bg-alt;
    border:           2px solid;
    border-color:     @accent-alt;
    border-radius:    12px;
    padding:          12px 16px;
}

textbox {
    background-color: transparent;
    text-color:       @accent-alt;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

/* Search input bar */
inputbar {
    background-color: @bg-alt;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    12px;
    padding:          14px 18px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 14";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    cursor:           text;
    placeholder:      "Type to search...";
    placeholder-color: #6c7086;
}

/* Theme list */
listview {
    background-color: transparent;
    columns:          1;
    lines:            5;
    spacing:          8px;
    scrollbar:        false;
    fixed-height:     true;
}

/* Individual theme items */
element {
    background-color: @bg-alt;
    text-color:       @fg;
    border-radius:    10px;
    padding:          14px 18px;
    cursor:           pointer;
}

element normal.normal {
    background-color: @bg-alt;
}

element alternate.normal {
    background-color: #262637;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
    border:           none;
}

element selected.active {
    background-color: @accent-alt;
    text-color:       @bg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font 13";
    vertical-align:   0.5;
}

element-icon {
    background-color: transparent;
    size:             24px;
}
