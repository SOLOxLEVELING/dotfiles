/**
 * Dracula Rofi Theme
 * Dark purple vampire aesthetic
 */

* {
    bg:              #282a36F0;
    bg-alt:          #44475a;
    bg-dark:         #21222c;
    fg:              #f8f8f2;
    fg-muted:        #6272a4;
    accent:          #bd93f9;
    accent-alt:      #ff79c6;
    
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    16px;
    width:            650px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: transparent;
    padding:          20px;
    spacing:          16px;
}

inputbar {
    background-color: @bg-dark;
    border:           1px solid;
    border-color:     @bg-alt;
    border-radius:    12px;
    padding:          14px 18px;
    spacing:          14px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font 14";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search apps...";
    placeholder-color: @fg-muted;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          6px;
    scrollbar:        true;
    fixed-height:     true;
}

scrollbar {
    background-color: @bg-alt;
    handle-color:     @accent;
    handle-width:     6px;
    border-radius:    3px;
    margin:           0 0 0 8px;
}

element {
    background-color: @bg-alt;
    text-color:       @fg;
    border-radius:    10px;
    padding:          12px 16px;
    spacing:          14px;
}

element normal.normal {
    background-color: transparent;
}

element alternate.normal {
    background-color: rgba(68, 71, 90, 0.5);
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    background-color: transparent;
    size:             32px;
    vertical-align:   0.5;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
