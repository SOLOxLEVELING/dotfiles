# Fastfetch Configuration
# Theme colors are loaded from theme.jsonc

logo:
    type: auto
    padding:
        top: 1
        left: 2
        right: 4

display:
    separator: "  "

modules:
    - type: title
      format: "{user-name-colored}@{host-name-colored}"
      
    - type: separator
      string: "─────────────────────────────────────"
      
    - type: os
      key: "  OS"
      
    - type: kernel
      key: "  Kernel"
      
    - type: packages
      key: "  Packages"
      
    - type: shell
      key: "  Shell"
      
    - type: wm
      key: "  WM"
      
    - type: terminal
      key: "  Terminal"
      
    - type: terminalfont
      key: "  Font"
      
    - type: separator
      string: "─────────────────────────────────────"
      
    - type: host
      key: "  Host"
      
    - type: cpu
      key: "  CPU"
      format: "{1} ({3}) @ {7} GHz"
      
    - type: gpu
      key: "  GPU"
      
    - type: memory
      key: "  Memory"
      
    - type: disk
      key: "  Disk"
      
    - type: separator
      string: "─────────────────────────────────────"
      
    - type: uptime
      key: "  Uptime"
      
    - type: localip
      key: "  Local IP"
      format: "{ipv4}"
      
    - type: separator
      string: "─────────────────────────────────────"
      
    - type: colors
      symbol: circle
      paddingLeft: 2
